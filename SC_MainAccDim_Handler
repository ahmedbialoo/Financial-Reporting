    public static void process(SC_AccStructureAccountsTmp _tmp)
    {
        SC_MainAccDim_Handler mainAccDim_Handler = new SC_MainAccDim_Handler();
        SC_AccStructureSegments accStructureSegmentsView;

        while select accStructureSegmentsView
            where accStructureSegmentsView.Name == curExt()
        {
            mainAccDim_Handler.loopSegmentsAndFillTmpData(accStructureSegmentsView.Level1 ,accStructureSegmentsView.DimensionHierarchy ,_tmp );
        }

    }

    public void loopSegmentsAndFillTmpData(str _segment ,DimensionHierarchyId _dimensionHierarchy , SC_AccStructureAccountsTmp _tmp)
    {
        SC_MainAccDim_Handler mainAccDim_Handler = new SC_MainAccDim_Handler();
        list segmentParts = SC_SegmentHandler::listOfSeparatedTxt(_segment,";");
        ListEnumerator En = segmentParts.getEnumerator();

        while(En.moveNext())
        {
            str segmentPart = En.current();
            str partDefinision = SC_SegmentHandler::defineSegment(segmentPart);
            mainAccDim_Handler.fillTmpData(partDefinision,segmentPart , _dimensionHierarchy , _tmp);
        }
    }

    public void fillTmpData(str _partDefinision , str _segmentPart ,DimensionHierarchyId _dimensionHierarchy, SC_AccStructureAccountsTmp _tmp)
    {
        
        MainAccount mainAccount;
        switch (_partDefinision)
        {
            case SC_OperatorDefinition::hasEndStars:

                //str txtBeforeStar = subStr(_segmentPart,1,strLen(_segmentPart)-1);
                str txtBeforeStar = SC_SegmentHandler::extractBefore(_segmentPart,"*");
                insert_recordset _tmp(MainAccountId,AccountStructure)
                    select MainAccountId , _dimensionHierarchy
                    from mainAccount
                    where mainAccount.MainAccountId like strFmt("%1*",txtBeforeStar);
                break;

            case SC_OperatorDefinition::isBetweenAndInclude:
                container textObject;

                textObject = SC_SegmentHandler::extractBeforeAfter(_segmentPart,"..");
                
                insert_recordset _tmp(MainAccountId,AccountStructure)
                    select MainAccountId , _dimensionHierarchy
                    from mainAccount
                    where mainAccount.MainAccountId >= conPeek(textObject,1)&&
                    mainAccount.MainAccountId <= conPeek(textObject,2);
                 
                break;
            case SC_OperatorDefinition::hasStartEndStars:
                str txtBetweenStars = SC_SegmentHandler::extractBetweenStars(_segmentPart);
                insert_recordset _tmp(MainAccountId,AccountStructure)
                    select MainAccountId , _dimensionHierarchy
                    from mainAccount
                    where mainAccount.MainAccountId like txtBetweenStars;
                break;
            case SC_OperatorDefinition::hasStartStars:
                str txtAfterStar = SC_SegmentHandler::extractAfter(_segmentPart,"*");
                insert_recordset _tmp(MainAccountId,AccountStructure)
                    select MainAccountId , _dimensionHierarchy
                    from mainAccount
                    where mainAccount.MainAccountId like strFmt("*%1",txtAfterStar);
                break;
            case SC_OperatorDefinition::isBetween:
                container txtBeforeAndAfter = SC_SegmentHandler::extractBeforeAfter(_segmentPart,"<..<");
                insert_recordset _tmp(MainAccountId,AccountStructure)
                    select MainAccountId , _dimensionHierarchy
                    from mainAccount
                    where mainAccount.MainAccountId > conPeek(txtBeforeAndAfter,1)&&
                    mainAccount.MainAccountId < conPeek(txtBeforeAndAfter,2);
                break;

            case SC_OperatorDefinition::isGreaterThan:
                str txtAfterGreaterThan = SC_SegmentHandler::extractAfter(_segmentPart,">");
                insert_recordset _tmp(MainAccountId,AccountStructure)
                    select MainAccountId , _dimensionHierarchy
                    from mainAccount
                    where mainAccount.MainAccountId > txtAfterGreaterThan;
                break;

            case SC_OperatorDefinition::isGreaterThanAndInclude:
                str txtbefore = SC_SegmentHandler::extractBefore(_segmentPart,"..*");
                insert_recordset _tmp(MainAccountId,AccountStructure)
                    select MainAccountId , _dimensionHierarchy
                    from mainAccount
                    where mainAccount.MainAccountId >= txtbefore;
                break;

            case SC_OperatorDefinition::isLessThan:
                str txtAfterLessThan = SC_SegmentHandler::extractAfter(_segmentPart,"<");
                insert_recordset _tmp(MainAccountId,AccountStructure)
                    select MainAccountId , _dimensionHierarchy
                    from mainAccount
                    where mainAccount.MainAccountId < txtAfterLessThan;
                break;

            case SC_OperatorDefinition::isLessThanAndInclude:
                str txtAfter = SC_SegmentHandler::extractAfter(_segmentPart,"*..");
                insert_recordset _tmp(MainAccountId,AccountStructure)
                    select MainAccountId , _dimensionHierarchy
                    from mainAccount
                    where mainAccount.MainAccountId <= txtAfterLessThan;
                break;
            case SC_OperatorDefinition::pureNumber:
                insert_recordset _tmp(MainAccountId,AccountStructure)
                    select MainAccountId , _dimensionHierarchy
                    from mainAccount
                    where mainAccount.MainAccountId == _segmentPart;
                break;


        }
    }

    public static void dimensionAttValueLookup(FormControl _callingControl)
    {
        SysTableLookup          sysTableLookup;
        Query                   query = new Query();
        QueryBuildDataSource    qbdsAttributeValue;
        QueryBuildDataSource    qbdsAttribute;
        str                     dimAttr = SC_MainAccDim_Handler::dimensionAttributeName;
        // Create SysTableLookup on DimensionAttributeValue
        sysTableLookup = SysTableLookup::newParameters(tableNum(DimensionAttributeValue), _callingControl);

        sysTableLookup.addLookupfield(fieldNum(DimensionAttributeValue, DisplayValue));
        sysTableLookup.addLookupfield(fieldNum(DimensionAttributeValue, DimensionAttribute));

        // Join to DimensionAttribute to filter by dimension name
        qbdsAttributeValue  = query.addDataSource(tableNum(DimensionAttributeValue));
        qbdsAttribute       = qbdsAttributeValue.addDataSource(tableNum(DimensionAttribute));
        qbdsAttribute.relations(false);
        qbdsAttribute.joinMode(JoinMode::InnerJoin);
        qbdsAttribute.addLink(fieldNum(DimensionAttributeValue, DimensionAttribute), fieldNum(DimensionAttribute, RecId));

        // Filter by dimension name
        qbdsAttribute.addRange(fieldNum(DimensionAttribute, Name)).value(queryValue(dimAttr));

        sysTableLookup.parmQuery(query);
        sysTableLookup.performFormLookup();
    }

