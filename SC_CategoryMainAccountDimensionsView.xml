    {
        
  
        str dimensionValue = sysComputedColumn::returnField(viewstr(SC_CategoryMainAccountDimensionsView),
                                   identifierStr(SC_MainAccountsDim), fieldStr(SC_MainAccountsDim, DimensionValue));
        str mainAccountId = sysComputedColumn::returnField(viewstr(SC_CategoryMainAccountDimensionsView),
                                   identifierStr(SC_CategoryMainAccounts), fieldStr(SC_CategoryMainAccounts, MainAccountId));
        return strFmt("ISNULL(%1, %2)", dimensionValue, mainAccountId);
       


      
    }

]]></Source>
