				<Source><![CDATA[
    public static str dimensionAttributeV2()
    {
        
  
        str dimensionAttribute = sysComputedColumn::returnField(viewstr(SC_CategoryMainAccountDimensionsView),
                                   identifierStr(SC_MainAccountsDim), fieldStr(SC_MainAccountsDim, DimensionAttribute));

        return strFmt("ISNULL(%1, '%2')", dimensionAttribute, "MainAccount");
      
    }

]]></Source>
